/run/initialize

# Visualization driver comes from $VIS_DRIVER (default VRML2FILE -> g4_00.wrl; use OGL for a window)
/control/getEnv VIS_DRIVER
/vis/open {VIS_DRIVER}
/vis/drawVolume
/vis/viewer/set/viewpointThetaPhi 70 20
/vis/scene/add/trajectories smooth
/vis/scene/endOfEventAction accumulate

# Hide optical photons, electrons and positrons in the display
/vis/filtering/trajectories/create/particleFilter
/vis/filtering/trajectories/particleFilter-0/add opticalphoton
/vis/filtering/trajectories/particleFilter-0/add e-
/vis/filtering/trajectories/particleFilter-0/add e+
/vis/filtering/trajectories/particleFilter-0/invert true

# Hide all neutral particles (gammas, neutrinos, neutrons, ...), i.e. every green track
/vis/filtering/trajectories/create/chargeFilter
/vis/filtering/trajectories/chargeFilter-0/add 0
/vis/filtering/trajectories/chargeFilter-0/invert true

# e-, e+, mu-, mu+, pi-, pi+, proton, anti_proton
/gun/particle mu+
/gun/energy 400 MeV
/run/beamOn 20

# Interactive: VIS_DRIVER=OGL ./waterCherenkovSim run_vis.mac -i

